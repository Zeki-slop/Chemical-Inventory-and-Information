{
  "name": "chemaware",
  "version": "1.0.0",
  "homepage": "https://shubhsawa.github.io/Chemical-inventory-and-information/",
  "private": true,
  "description": "ChemAware - Web3 Chemical Information Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
