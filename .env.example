# ---- Frontend (Vite) env vars must be prefixed with VITE_ ----

# Public APIs (no key required for PubChem; OpenFDA & Open Food Facts are keyless too,
# but OpenFDA allows an optional key for higher rate limits)
VITE_OPENFDA_API_KEY=

# Smart contract deployment address (filled in after `npm run deploy:local` / `deploy:sepolia`)
VITE_CONTRACT_ADDRESS=

# Network the frontend should expect MetaMask to be on: "sepolia" | "localhost"
VITE_DEFAULT_NETWORK=sepolia

# IPFS / Pinata (used to pin full report JSON off-chain; only the CID is stored on-chain)
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_KEY=
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ---- Hardhat (backend / deployment only, NEVER prefix with VITE_ or it leaks to the client) ----

# RPC URL for Sepolia testnet, e.g. from Alchemy or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key

# Deployer wallet private key (use a burner/testnet-only wallet, never a real funded key)
PRIVATE_KEY=

# Etherscan API key, used by hardhat-toolbox to verify the contract source after deployment
ETHERSCAN_API_KEY=
